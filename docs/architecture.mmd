---
title: VibeKids — a coding agent for kids
---
flowchart TB
    kid(["🧒 Kid: &quot;make a button game!&quot;"]):::actor

    subgraph browser["🖥️  Browser — Next.js 16 · React 19 · Convex live hooks"]
        direction LR
        chat["💬 AvatarChat<br/>messages · buildStatus<br/>queue / next-turn"]
        preview["▶️ PreviewPane<br/>iframe srcdoc · Sandpack<br/>renders from files"]
        chips["✨ SuggestionChips<br/>idea · microchoice"]
    end

    subgraph server["⚙️  /api/chat — Next.js Node-runtime route"]
        direction TB
        guard["env-guard: check the LLM credential"]:::danger
        continuity["continuity guard<br/>inject file tree → edit, don't recreate"]
        loop["Agent SDK query() loop<br/>maxTurns 8 · streams deltas"]
        guard --> continuity --> loop
    end

    subgraph agent["🤖  Claude Agent SDK — &quot;Sparky&quot;"]
        direction LR
        persona["SPARKY_SYSTEM persona<br/>modelForRole('balanced')"]
        tools["Sparky MCP tools<br/>create_project · write_file · edit_file<br/>run_preview · suggest_idea · start_micro_choice"]
    end

    claude["☁️  Claude — Haiku · Sonnet · Opus<br/>API key (default)"]:::external

    subgraph convex["🗄️  Convex — realtime store · single source of truth"]
        tables["projects · files · messages · suggestions · buildStatus"]:::store
    end

    kid --> chat
    chips -->|"tap → enqueue → next turn"| chat
    chat ==>|"POST · projectId + text"| guard
    loop <-->|"query(): system = persona, model = Sonnet"| persona
    loop ==>|"tool calls"| tools
    persona <-->|"prompt · stream  (Agent SDK)"| claude
    tools ==>|"mutations: write file · add msg · set status · add chips"| tables
    loop ==>|"appendText: stream avatar bubble"| tables

    tables -.->|"realtime · live subscriptions re-render chat · preview · chips"| browser

