# VibeKids environment — copy to .env.local and fill in.

# --- LLM provider ---
# "api" (default)  = Anthropic API key. Bedrock/Vertex also work via the Agent SDK's own env vars.
# "subscription"   = opt-in, for personal local experiments only: authenticates with your own
#                    CLAUDE_CODE_OAUTH_TOKEN. Never use it for an app other people use; see
#                    https://code.claude.com/docs/en/agent-sdk/overview
LLM_PROVIDER=api

# Required when LLM_PROVIDER=api.
ANTHROPIC_API_KEY=

# Only for LLM_PROVIDER=subscription (personal local experiments). Mint with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Convex (auto-filled by `npx convex dev` on first run) ---
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
